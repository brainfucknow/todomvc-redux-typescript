    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jsdom": "^30.0.1",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.10.1",
