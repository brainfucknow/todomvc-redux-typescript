{
  "name": "todomvc",
  "version": "0.0.1",
  "private": true,
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.56.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.10.1",
    "@types/classnames": "^2.2.10",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "classnames": "^2.2.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-redux": "^9.2.0",
    "redux": "^5.0.1",
    "reselect": "^4.0.0",
    "todomvc-app-css": "^2.3.0",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:scripts": "vitest run --project scripts",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "node scripts/typecheck.mjs",
    "test:e2e": "npm run build && playwright test --config qa/playwright.config.ts",
    "test:e2e:dev": "npm run build && playwright test --config qa/playwright.dev.config.ts",
    "test:e2e:preview": "npm run build && playwright test --config qa/playwright.preview.config.ts"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ]
}
